{
  "schemaVersion": 3,
  "id": "pi",
  "name": "Pi",
  "version": "1.3.2",
  "minHppVersion": "0.1.0",
  "description": "Pi SDK programming agent",
  "entry": "agent.mjs",
  "runtime": "sdk",
  "packageName": "@earendil-works/pi-coding-agent",
  "order": 20,
  "installHint": "在通用设置中更新 Pi SDK，或运行 npm install @earendil-works/pi-coding-agent@latest",
  "updateCommand": "npm install @earendil-works/pi-coding-agent@latest",
  "shortName": "PI",
  "capabilities": {
    "planMode": "native",
    "permissions": true,
    "guidance": true,
    "fork": true,
    "actions": true,
    "compaction": {
      "customModel": true,
      "thinkingLevel": true,
      "toggle": true,
      "channelModel": true
    },
    "subagent": {
      "supported": true,
      "configurable": true,
      "modelSelection": "inherit-or-custom",
      "profiles": [
        { "name": "scout", "label": "Scout", "description": "只读检索代码库" },
        { "name": "planner", "label": "Planner", "description": "制定实施计划" },
        { "name": "reviewer", "label": "Reviewer", "description": "审查实现和回归风险" },
        { "name": "worker", "label": "Worker", "description": "在隔离上下文中完成开发任务" }
      ]
    },
    "builtinExtensions": {
      "userConfigurable": true,
      "defaultEnabled": [],
      "options": [
        {
          "id": "codemode",
          "label": "Codemode",
          "description": "让模型用一段 JS 脚本批量编排工具调用，能省token 但会改变工具调用形态。Plan（只读）模式下不可用。",
          "hotReload": true
        },
        {
          "id": "tool_search",
          "label": "Tool search",
          "description": "按需检索并加载未声明的工具，适合工具集很大的场景。纯检索，无副作用。依赖 MCP 才有意义。",
          "hotReload": true
        },
        {
          "id": "mcp",
          "label": "MCP",
          "description": "读取 ~/.pi/agent/mcp.json 里的服务器并接入其工具。权限按工具自带的注解判定（只读免询问、破坏性与未声明的仍会询问）。",
          "hotReload": true
        }
      ]
    },
    "configuration": {
      "type": "provider",
      "storage": "plugin",
      "endpoints": [
        { "id": "chat-completions", "label": "Chat Completions (/chat/completions)" },
        { "id": "responses", "label": "Responses (/responses)" },
        { "id": "anthropic-messages", "label": "Anthropic Messages (/messages)" },
        { "id": "mistral-conversations", "label": "Mistral Conversations" },
        { "id": "azure-openai-responses", "label": "Azure OpenAI Responses" },
        { "id": "openai-codex-responses", "label": "OpenAI Codex Responses" },
        { "id": "bedrock-converse-stream", "label": "Amazon Bedrock Converse" },
        { "id": "google-generative-ai", "label": "Google Generative AI" },
        { "id": "google-vertex", "label": "Google Vertex AI" }
      ],
      "defaultEndpoint": "chat-completions",
      "pathLabel": "~/.pi/agent/models.json",
      "hint": "渠道由 Pi 插件无损读写 models.json，图片能力映射到模型 input。",
      "modelDefaults": { "reasoning": false, "imageInput": false },
      "fixedModelCapabilities": false,
      "modelListMode": "configured"
    }
  }
}
