{
  "schemaVersion": 3,
  "id": "opencode",
  "name": "OpenCode",
  "version": "1.4.0",
  "minHppVersion": "0.1.0",
  "description": "OpenCode CLI programming agent (1.x / 2.x)",
  "entry": "agent.mjs",
  "runtime": "cli",
  "command": "opencode",
  "packageName": "opencode-ai",
  "packages": [
    { "line": "v2", "name": "@opencode/cli", "label": "OpenCode 2.x（推荐）" },
    { "line": "v1", "name": "opencode-ai", "label": "OpenCode 1.x" }
  ],
  "order": 30,
  "installHint": "npm install -g @opencode/cli   # OpenCode 2.x（推荐）\nnpm install -g opencode-ai     # OpenCode 1.x",
  "updateCommand": "npm install -g @opencode/cli@latest",
  "shortName": "OC",
  "capabilities": {
    "planMode": "native",
    "permissions": true,
    "guidance": false,
    "fork": true,
    "actions": true,
    "compaction": {
      "customModel": true,
      "thinkingLevel": true
    },
    "configuration": {
      "type": "provider",
      "storage": "plugin",
      "endpoints": [
        { "id": "chat-completions", "label": "Chat Completions (/chat/completions)" },
        { "id": "responses", "label": "Responses (/responses)" },
        { "id": "anthropic-messages", "label": "Anthropic Messages (/v1/messages)" }
      ],
      "defaultEndpoint": "chat-completions",
      "pathLabel": "~/.config/opencode/opencode.json",
      "hint": "渠道由 OpenCode 插件读写 provider 配置。",
      "modelDefaults": { "reasoning": false, "imageInput": false },
      "fixedModelCapabilities": false,
      "modelListMode": "merge"
    }
  }
}
