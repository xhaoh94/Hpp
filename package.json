{
  "name": "hpp",
  "version": "0.1.1",
  "description": "Lightweight terminal project manager",
  "main": "out/main/main.js",
  "scripts": {
    "postinstall": "node scripts/ensure-electron.cjs && node scripts/patch-dev-electron-icon.cjs",
    "dev": "electron-vite dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:release": "tsc -p tsconfig.release.node.json --pretty false && tsc -p tsconfig.release.web.json --pretty false && tsc -p mobile/tsconfig.release.json --pretty false",
    "verify:pi-package": "node scripts/verify-pi-package.cjs",
    "offline:build": "node offline-installers/build-offline.cjs",
    "verify:subagents:live-preflight": "node scripts/verify-subagent-live-preflight.cjs",
    "verify:subagent:live": "node scripts/verify-subagent-live-execution.cjs",
    "build": "npm run typecheck:release && electron-vite build && npm run verify:pi-package && node scripts/package-agent-plugins.cjs && npm run mobile:build && node scripts/package-mobile-web.cjs",
    "dist": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-desktop-release.ps1",
    "dist:linux": "npm run build && electron-builder --linux AppImage --x64 --publish never",
    "dist:publish": "npm run build && electron-builder --publish always",
    "preview": "electron-vite preview",
    "web:dev": "npm run mobile:dev",
    "web:build": "npm run mobile:build",
    "web:preview": "vite preview --config mobile/vite.config.ts --host 0.0.0.0",
    "mobile:dev": "vite --config mobile/vite.config.ts",
    "mobile:build": "vite build --config mobile/vite.config.ts",
    "mobile:sync": "npm run mobile:build && cd mobile && npx cap sync android",
    "mobile:android": "cd mobile && npx cap open android",
    "mobile:apk": "npm run mobile:sync && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android-debug.ps1",
    "mobile:release": "npm run mobile:sync && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android-release.ps1",
    "release:github": "node scripts/reset-github-release.cjs",
    "release": "node scripts/release-all.cjs",
    "release:build": "node scripts/release-all.cjs --build",
    "release:linux": "node scripts/release-all.cjs --skip-build --skip-linux"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor-mlkit/barcode-scanning": "^8.1.0",
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.0.1",
    "@capacitor/camera": "^8.2.1",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@tailwindcss/vite": "^4.3.1",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@electron-toolkit/utils": "^4.0.0",
    "@lexical/clipboard": "^0.49.0",
    "@lexical/react": "^0.49.0",
    "@lexical/utils": "^0.49.0",
    "@replit/codemirror-minimap": "^0.5.2",
    "@tanstack/react-virtual": "^3.14.9",
    "adm-zip": "^0.5.18",
    "codemirror": "^6.0.2",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "highlight.js": "^11.11.1",
    "lexical": "^0.49.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.21.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2",
    "ws": "^8.21.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.14"
  },
  "build": {
    "appId": "com.hpp.app",
    "productName": "hpp",
    "forceCodeSigning": false,
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "xhaoh94",
        "repo": "Hpp",
        "releaseType": "release"
      }
    ],
    "files": [
      "out/**/*"
    ],
    "asar": false,
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "mac": {
      "icon": "public/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon.png",
      "category": "Development",
      "artifactName": "Hpp-Linux-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    }
  },
  "allowScripts": {
    "electron@43.3.0": true,
    "esbuild@0.25.12": true
  }
}